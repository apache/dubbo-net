<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <_CompatibilityFeed>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'compatibility'))</_CompatibilityFeed>
    <_CompatibilityStateFile>$(_CompatibilityFeed)PackageVersion.props</_CompatibilityStateFile>
  </PropertyGroup>
  <!-- Generated by Prepare.proj, under ignored artifacts. Global command-line
       version overrides remain possible for explicit diagnostic runs. -->
  <Import Project="$(_CompatibilityStateFile)" Condition="Exists('$(_CompatibilityStateFile)')" />
  <PropertyGroup>
    <!-- A real NuGet consumer, NOT a ProjectReference: verifies nearest-asset
         selection, dependency resolution and Framework binding redirects. -->
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net6.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DubboNetPackageVersion Condition="'$(DubboNetPackageVersion)' == ''">3.6.2-compat-validation</DubboNetPackageVersion>
    <!-- An explicit config path also applies when the entry point is the .sln;
         merely placing NuGet.Config beside this .csproj is not sufficient. -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <RestorePackagesPath>$(_CompatibilityFeed)packages</RestorePackagesPath>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exact prerelease identity: never silently fall forward to a public release. -->
    <PackageReference Include="DubboNet" Version="[$(DubboNetPackageVersion)]" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"
                      PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="System.Net.Http" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <Target Name="RequirePreparedCompatibilityPackage"
          BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="!Exists('$(_CompatibilityStateFile)') Or !Exists('$(_CompatibilityFeed)DubboNet.$(DubboNetPackageVersion).nupkg')"
           Text="The local compatibility package is missing. From the repository root run: dotnet msbuild Tests/PackageCompatibilitySmoke/Prepare.proj" />
  </Target>
</Project>
